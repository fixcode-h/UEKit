        "url": "https://github.com/fixcode-h/UEKit/releases/download/UELink-v2.14.0/UELink-2.14.0-src.zip",
        "sha256": "5ab611e0db32cdce5f345a4958794397abb1fa28c51ad598b04453d566c8eb9d",
