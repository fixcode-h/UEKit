{
  "FileVersion": 3,
  "Version": 12,
  "VersionName": "1.3.3-beta.1",
  "FriendlyName": "AssetForge",
  "Description": "用 JSON 配置管理 UMG、蓝图、行为树、状态树、材质、Niagara 等资产：导入、导出、演练、同步状态、属性差异。界面在 Agent 面板的 UE 页，经 UELink 通信。",
  "Category": "Developer Tools",
  "CreatedBy": "fixcode-h",
  "CreatedByURL": "https://github.com/fixcode-h/UEKit",
  "DocsURL": "https://github.com/fixcode-h/UEKit/tree/main/plugins/AssetForge",
  "CanContainContent": false,
  "Installed": false,
  "EnabledByDefault": true,
  "Modules": [
    {
      "Name": "AssetForge",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    },
    {
      "Name": "AssetForgeTests",
      "Type": "UncookedOnly",
      "LoadingPhase": "PostEngineInit",
      "TargetAllowList": ["Editor"]
    }
  ],
  "Plugins": [
    { "Name": "UELink", "Enabled": true },
    { "Name": "StateTree", "Enabled": true },
    { "Name": "PropertyBindingUtils", "Enabled": true, "Optional": true },
    { "Name": "Niagara", "Enabled": true },
    { "Name": "DataValidation", "Enabled": true },
    { "Name": "CQTest", "Enabled": true, "Optional": true }
  ]
}
